# Zkopíruj tento soubor jako .env a doplň hodnoty. Soubor .env nikomu neposílej.

# Claude API – klíč z https://console.anthropic.com (Settings → API Keys)
ANTHROPIC_API_KEY=

# Smoobu – oba povinné (HMAC ověřování; staré Api-Key Smoobu 31. 10. 2026 vypíná).
# Smoobu → Settings → Advanced → API Keys → Create API Key + Generate Secret (secret se ukáže jen jednou)
SMOOBU_API_KEY=
SMOOBU_API_SECRET=

# Telegram – kam ti agent posílá upozornění (návod v README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# navrh = agent hostům nic neposílá, jen ti posílá návrhy  |  ostre = odpovídá sám
REZIM=navrh

# Jak často kontrolovat nové zprávy (minuty)
INTERVAL_MINUT=3

# Návrhy hodnocení hostů z Airbnb (ano/ne) a v kolik hodin je denně připravit
HODNOCENI_HOSTU=ano
HODNOCENI_HODINA=11

# Model Claude (výchozí claude-opus-5; levnější varianta: claude-sonnet-5)
MODEL=claude-opus-5
PRIJEZD_HODINA=18
PRIJEZD_ODESLAT_HODINA=10
# ano = instrukce k příjezdu posílat bez schválení (odpovědi hostům dál podle REZIM)
PRIJEZDY_AUTOMATICKY=ne
# ano = instrukce k příjezdu skládá kód ze šablony v obecne.yaml (kódy, Wi-Fi, časy ze zdroje pravdy),
# model jen překládá pro neanglické hosty a překlad se ověřuje; vyžaduje adresa_en, postup_en, odjezd.postup_en u bytů
INSTRUKCE_ZE_SABLONY=ne

# Aplikace úklidů – stav úklidů a kódy zapsané u úklidů (agent se přihlašuje vlastním účtem). Prázdné = vypnuto.
UKLIDY_URL=https://uklid.kolbl-apartments.cz
UKLIDY_LOGIN=
UKLIDY_HESLO=
UKLIDY_INTERVAL_MINUT=10
DRIVEJSI_CHECKIN_OD=10:00
UKLID_KONTROLA_HODINA=14

# Jak často hlídat dvojí rezervace (hodiny)
KONTROLA_KALENDARE_HODIN=1
