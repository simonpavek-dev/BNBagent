# Zkopíruj tento soubor jako .env a doplň hodnoty. Soubor .env nikomu neposílej.

# Claude API – klíč z https://console.anthropic.com (Settings → API Keys)
ANTHROPIC_API_KEY=

# Smoobu – oba povinné (HMAC ověřování; staré Api-Key Smoobu 31. 10. 2026 vypíná).
# Smoobu → Settings → Advanced → API Keys → Create API Key + Generate Secret (secret se ukáže jen jednou)
SMOOBU_API_KEY=
SMOOBU_API_SECRET=

# Telegram – kam ti agent posílá upozornění (návod v README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# navrh = agent hostům nic neposílá, jen ti posílá návrhy  |  ostre = odpovídá sám
REZIM=navrh

# Jak často kontrolovat nové zprávy (minuty)
INTERVAL_MINUT=3

# Návrhy hodnocení hostů z Airbnb (ano/ne) a v kolik hodin je denně připravit
HODNOCENI_HOSTU=ne
HODNOCENI_HODINA=11

# Model Claude (výchozí claude-opus-5; levnější varianta: claude-sonnet-5)
MODEL=claude-opus-5
PRIJEZD_HODINA=18
PRIJEZD_ODESLAT_HODINA=10
# ano = instrukce k příjezdu posílat bez schválení (odpovědi hostům dál podle REZIM)
PRIJEZDY_AUTOMATICKY=ne
# ano = po každé odpovědi, kterou agent v ostrém režimu (REZIM=ostre) poslal hostovi sám, přijde do skupiny
# oznámení „✅ Vasil odpověděl hostovi sám“ i s textem (bez tlačítek)
HLASIT_AUTOMATICKE_ODPOVEDI=ne
# ano = po zprávě hosta agent počká (výchozí 5 min), jestli nenapíše ještě něco, a pak odpoví na všechny zprávy
# jednou zprávou; každá další zpráva odpočet spustí znovu, nejdéle 15 min od první; naléhavé zprávy hned
POCKAT_NA_DALSI_ZPRAVY=ne
POCKAT_NA_DALSI_ZPRAVY_MINUT=5
# ano = jednoduché zprávy hostů (díky, ok, čas příjezdu – bez otázky, prosby a problému) vyřídí levnější model
LEVNEJSI_MODEL_PRO_JEDNODUCHE=ne
# ano = čisté zdvořilosti hostů (díky, 👍, ok) vyřídí pravidlo bez modelu – odpověď z hotových vět v jazyce hosta
ZDVORILOSTI_BEZ_MODELU=ne
MODEL_JEDNODUCHE=claude-sonnet-5

# Aplikace úklidů – stav úklidů a kódy zapsané u úklidů (agent se přihlašuje vlastním účtem). Prázdné = vypnuto.
UKLIDY_URL=https://uklid.kolbl-apartments.cz
UKLIDY_LOGIN=
UKLIDY_HESLO=
UKLIDY_INTERVAL_MINUT=10
DRIVEJSI_CHECKIN_OD=10:00
UKLID_KONTROLA_HODINA=14

# Jak často hlídat dvojí rezervace (hodiny)
KONTROLA_KALENDARE_HODIN=1

# ---- přepínače funkcí (výchozí vypnuto; ano = zapnuto)
# hodinová kontrola kalendáře – dvojí rezervace / otevřené obsazené noci (KONTROLA_KALENDARE_HODIN)
KONTROLA_KALENDARE=ne
# když je úklid v den příjezdu hotový dřív, nabídnout hostovi dřívější check-in (vždy ke schválení)
NABIDKA_DRIVEJSIHO_CHECKINU=ne
# ve UKLID_KONTROLA_HODINA upozornit, když byt k dnešnímu příjezdu ještě není uklizený
HLIDANI_UKLIDU_K_PRIJEZDU=ne
# po změně kódu v aplikaci úklidů poslat opravu hostům, kteří už mají instrukce se starým kódem (DECISIONS D3)
OPRAVA_KODU_PO_UKLIDU=ne
# ovládání přes Telegram skupinu („Vasile, …“)
CHAT_PRES_TELEGRAM=ne
