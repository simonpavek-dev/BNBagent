# Zkopíruj tento soubor jako .env a doplň hodnoty. Soubor .env nikomu neposílej.

# Claude API – klíč z https://console.anthropic.com (Settings → API Keys)
ANTHROPIC_API_KEY=

# Smoobu – oba povinné (HMAC ověřování; staré Api-Key Smoobu 31. 10. 2026 vypíná).
# Smoobu → Settings → Advanced → API Keys → Create API Key + Generate Secret (secret se ukáže jen jednou)
SMOOBU_API_KEY=
SMOOBU_API_SECRET=

# Telegram – kam ti agent posílá upozornění (návod v README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# navrh = agent hostům nic neposílá, jen ti posílá návrhy  |  ostre = odpovídá sám
REZIM=navrh

# Jak často kontrolovat nové zprávy (minuty)
INTERVAL_MINUT=3

# Návrhy hodnocení hostů z Airbnb (ano/ne) a v kolik hodin je denně připravit
HODNOCENI_HOSTU=ne
HODNOCENI_HODINA=11

# Model Claude (výchozí claude-opus-5; levnější varianta: claude-sonnet-5)
MODEL=claude-opus-5
PRIJEZD_HODINA=18
PRIJEZD_ODESLAT_HODINA=10
# ano = instrukce k příjezdu posílat bez schválení (odpovědi hostům dál podle REZIM)
PRIJEZDY_AUTOMATICKY=ne
# ano = po každé odpovědi, kterou agent v ostrém režimu (REZIM=ostre) poslal hostovi sám, přijde do skupiny
# oznámení „✅ Vasil odpověděl hostovi sám“ i s textem (bez tlačítek)
HLASIT_AUTOMATICKE_ODPOVEDI=ne
# ano = po zprávě hosta agent počká (výchozí 5 min), jestli nenapíše ještě něco, a pak odpoví na všechny zprávy
# jednou zprávou; každá další zpráva odpočet spustí znovu, nejdéle 15 min od první; naléhavé zprávy hned
POCKAT_NA_DALSI_ZPRAVY=ne
POCKAT_NA_DALSI_ZPRAVY_MINUT=5
# ano = podpis (hostitel.podpis v obecne.yaml) nepíše model, doplní ho agent jen do první naší zprávy v konverzaci
# a do zpráv po skončení pobytu; instrukce k příjezdu ho mají vždy, ostatní zprávy jsou bez podpisu
PODPIS_JEN_ZACATEK_A_KONEC=ne
# ano = večer před odjezdem (v ZPRAVA_PRED_ODJEZDEM_HODINA) odejde hostovi sama připomínka check-outu (čas a postup ze
# znalostní báze) a poděkování; hostům z Airbnb i sleva SLEVA_NA_DALSI_POBYT_PROCENT na další pobyt (0 = bez slevy).
# Připraví se 2 h předem, ve skupině jde zrušit. Pobyt na 1 noc ji nedostane. Sleva NESMÍ záviset na hodnocení (D6).
ZPRAVA_PRED_ODJEZDEM=ne
ZPRAVA_PRED_ODJEZDEM_HODINA=18
SLEVA_NA_DALSI_POBYT_PROCENT=0
# ano = v den odjezdu (v PROSBA_O_HODNOCENI_HODINA, po check-outu) odejde sama prosba o hodnocení; když host během
# pobytu eskaloval (stížnost, porucha…), jen ke schválení
PROSBA_O_HODNOCENI=ne
PROSBA_O_HODNOCENI_HODINA=12
# ano = příkaz /status ve skupině: stav bytů (obsazeno do / dnes odjezd, příjezd / volno do) a kódy ke dveřím domu
# a bytu, když tam jdete vy nebo úklid. Zpráva s kódy se po 15 minutách smaže i s příkazem. Jen ve vaší skupině.
PRIKAZ_STATUS=ne
# ano = v neděli v TYDENNI_PREHLED_HODINA přijde přehled týdne: kde vás Vasil potřeboval, proč a co doplnit do
# znalostní báze, aby to příště zvládl sám (doporučení napíše model, 1 volání týdně). Na požádání i příkaz /prehled.
TYDENNI_PREHLED=ne
TYDENNI_PREHLED_HODINA=19
# ano = hlídání Poslanecké sněmovny: návrhy zákonů a jednání o eTuristovi, registraci bytů, limitu nocí, kolaudaci,
# pravomocech Prahy a dalších omezeních krátkodobého ubytování (otevřená data psp.cz). Zprávy „🏛️ SNĚMOVNA“ do skupiny
# hned při změně a v pondělí v LEGISLATIVA_SOUHRN_HODINA souhrn; data se stahují v LEGISLATIVA_HODINY.
HLIDANI_LEGISLATIVY=ne
LEGISLATIVA_HODINY=7,19
LEGISLATIVA_SOUHRN_HODINA=8
# ano = na dotaz hosta na podnik (restaurace, kavárna, bar…) agent najde v Google Maps až 3 podniky v okolí bytu:
# hodnocení aspoň DOPORUCENI_MIN_HODNOCENI z aspoň DOPORUCENI_MIN_RECENZI recenzí, otevřeno v den a čas, na který se host
# ptá, do DOPORUCENI_MAX_PESKY_MIN minut pěšky. Potřebuje klíč Google Places API (New): console.cloud.google.com →
# APIs & Services → zapnout „Places API (New)“ → Credentials → API key (omezit na Places API). Cena 35 $ / 1 000 dotazů,
# prvních 1 000 měsíčně zdarma.
DOPORUCENI_PODNIKU=ne
GOOGLE_MAPS_API_KEY=
DOPORUCENI_MIN_HODNOCENI=4.0
DOPORUCENI_MIN_RECENZI=100
DOPORUCENI_MAX_PESKY_MIN=15
# ano = jednoduché zprávy hostů (díky, ok, čas příjezdu – bez otázky, prosby a problému) vyřídí levnější model
LEVNEJSI_MODEL_PRO_JEDNODUCHE=ne
# ano = čisté zdvořilosti hostů (díky, 👍, ok) vyřídí pravidlo bez modelu – odpověď z hotových vět v jazyce hosta
ZDVORILOSTI_BEZ_MODELU=ne
MODEL_JEDNODUCHE=claude-sonnet-5

# Aplikace úklidů – stav úklidů a kódy zapsané u úklidů (agent se přihlašuje vlastním účtem). Prázdné = vypnuto.
UKLIDY_URL=https://uklid.kolbl-apartments.cz
UKLIDY_LOGIN=
UKLIDY_HESLO=
UKLIDY_INTERVAL_MINUT=10
DRIVEJSI_CHECKIN_OD=10:00
UKLID_KONTROLA_HODINA=14

# Jak často hlídat dvojí rezervace (hodiny)
KONTROLA_KALENDARE_HODIN=1

# ---- přepínače funkcí (výchozí vypnuto; ano = zapnuto)
# hodinová kontrola kalendáře – dvojí rezervace / otevřené obsazené noci (KONTROLA_KALENDARE_HODIN)
KONTROLA_KALENDARE=ne
# když je úklid v den příjezdu hotový dřív, nabídnout hostovi dřívější check-in (vždy ke schválení)
NABIDKA_DRIVEJSIHO_CHECKINU=ne
# ve UKLID_KONTROLA_HODINA upozornit, když byt k dnešnímu příjezdu ještě není uklizený
HLIDANI_UKLIDU_K_PRIJEZDU=ne
# po změně kódu v aplikaci úklidů poslat opravu hostům, kteří už mají instrukce se starým kódem (DECISIONS D3)
OPRAVA_KODU_PO_UKLIDU=ne
# ovládání přes Telegram skupinu („Vasile, …“)
CHAT_PRES_TELEGRAM=ne
